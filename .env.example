# Copy to .env for local development. Never commit the real API key.
MODEL_SOURCE=/models/model
MODEL_ID=internal-model
MODEL_REVISION=unversioned
MODEL_FORMAT=safetensors
INFERENCE_ENGINE=transformers
MODEL_DTYPE=bfloat16
MODEL_MAX_CONTEXT=8192
MODEL_MAX_NEW_TOKENS=1024
MAX_PROMPT_TOKENS=7168
MAX_BATCH_TOKENS=32768
DEVICE=cuda
MAX_CONCURRENT_REQUESTS=1
REQUEST_QUEUE_TIMEOUT_SECONDS=0.25
GENERATION_TIMEOUT_SECONDS=300
API_KEY=replace-with-a-long-random-value
ALLOW_UNAUTHENTICATED=false
ENVIRONMENT=production
