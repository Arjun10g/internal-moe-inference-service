# Qwen3-Coder GGUF profile downloaded by `make qwen-download`.
MODEL_SOURCE=/models/model
MODEL_ID=qwen3-coder-30b-a3b-q4xl
MODEL_REVISION=sha256-e71c9271166ad648
MODEL_FORMAT=gguf
INFERENCE_ENGINE=llama_cpp
MODEL_MAX_CONTEXT=8192
MODEL_MAX_NEW_TOKENS=2048
MAX_PROMPT_TOKENS=6144
MAX_BATCH_TOKENS=8192
DEVICE=auto
MAX_CONCURRENT_REQUESTS=1
REQUEST_QUEUE_TIMEOUT_SECONDS=0.25
GENERATION_TIMEOUT_SECONDS=600
API_KEY=replace-with-a-long-random-value
ALLOW_UNAUTHENTICATED=false
ENVIRONMENT=production
LLAMA_SERVER_PATH=/opt/llama.cpp/llama-server
LLAMA_CPP_REQUIRE_PINNED_RUNTIME=true
LLAMA_CPP_STARTUP_TIMEOUT_SECONDS=1800
LLAMA_CPP_THREADS=0
LLAMA_CPP_BATCH_SIZE=512
LLAMA_CPP_UBATCH_SIZE=128
LLAMA_CPP_GPU_LAYERS=-1
LLAMA_CPP_KV_CACHE_TYPE=f16
LLAMA_CPP_REPACK=false
